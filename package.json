{
  "name": "collab-forge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "pi-extension/forge.ts",
    "pi-extension/README.md",
    "pi-extension/controller.ts",
    "pi-extension/config.ts",
    "pi-extension/schemas.ts",
    "client/",
    "scripts/forge.mjs",
    "scripts/forge-project-root.mjs",
    "skills/collab-forge-client/",
    "pi-extension/direct-fetch.ts",
    "codex/",
    "scripts/forge-codex-hook.mjs",
    "docs/codex.md",
    "docs/codex-checkout.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./pi-extension/forge.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test pi-extension/*.test.ts client/*.test.ts codex/*.test.ts",
    "test:e2e": "go build -o bin/forged ./cmd/forged && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "forge": "node scripts/forge.mjs",
    "test:codex": "tsx --test codex/*.test.ts",
    "test:codex-e2e": "go build -o bin/forged ./cmd/forged && tsx --test tests/codex-e2e.test.ts",
    "test:codex-live": "go build -o bin/forged ./cmd/forged && tsx --test tests/codex-live-smoke.test.ts",
    "test:checkout-e2e": "go build -o bin/forged ./cmd/forged && tsx --test tests/codex-checkout-e2e.test.ts",
    "test:checkout-live": "go build -o bin/forged ./cmd/forged && tsx --test tests/codex-checkout-live.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "tsx": "4.23.13",
    "typebox": "1.3.7",
    "undici": "7.29.1",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "bin": {
    "forge": "scripts/forge.mjs"
  }
}
