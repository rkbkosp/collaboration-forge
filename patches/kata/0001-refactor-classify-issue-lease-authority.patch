+package daemon
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/db"
+)
+
+// K1 contract: classify authority without opening standalone routes or changing
+// either route family's existing refusal semantics.
+func TestIssueLeaseAuthorityClassification(t *testing.T) {
+	ctx := context.Background()
+	store := openClaimGateHelperDB(t)
+	project, _ := createClaimGateHelperIssue(t, store)
+	tests := []struct {
+		name          string
+		binding       db.FederationBinding
+		err           error
+		want          issueLeaseAuthority
+		actionStatus  int
+		actionCode    string
+		actionMessage string
+		forceStatus   int
+		forceCode     string
+	}{
+		{name: "standalone", err: db.ErrNotFound, want: leaseAuthorityStandalone, actionStatus: 404, actionCode: "federation_not_found", actionMessage: "project is not federated", forceStatus: 404, forceCode: "federation_not_found"},
+		{name: "hub", binding: db.FederationBinding{Role: db.FederationRoleHub, Enabled: true}, want: leaseAuthorityHub},
+		{name: "spoke", binding: db.FederationBinding{Role: db.FederationRoleSpoke, Enabled: true}, want: leaseAuthoritySpoke, forceStatus: 409, forceCode: "federated_read_only"},
+		{name: "disabled", binding: db.FederationBinding{Role: db.FederationRoleHub}, want: leaseAuthorityDisabled, actionStatus: 409, actionCode: "federated_read_only", actionMessage: "federation binding is disabled", forceStatus: 409, forceCode: "federated_read_only"},
+		{name: "invalid role", binding: db.FederationBinding{Role: "invalid", Enabled: true}, want: leaseAuthorityDisabled, actionStatus: 409, actionCode: "federated_read_only", actionMessage: "unknown federation binding role", forceStatus: 409, forceCode: "federated_read_only"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			tt.binding.ProjectID = project.ID
+			wrapped := leaseAuthorityTestStore{Storage: store, binding: tt.binding, err: tt.err}
+			authority, binding, err := resolveIssueLeaseAuthority(ctx, wrapped, project.ID)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, authority)
+			if tt.err == nil {
+				assert.Equal(t, tt.binding, binding)
+			}
+			_, err = claimBinding(ctx, wrapped, project.ID)
+			if tt.actionStatus == 0 {
+				require.NoError(t, err)
+			} else {
+				assertClaimGateHelperAPIError(t, err, tt.actionStatus, tt.actionCode)
+				assert.Contains(t, err.Error(), tt.actionMessage)
+			}
+			err = requireHubClaimBinding(ctx, wrapped, project.ID)
+			if tt.forceStatus == 0 {
+				require.NoError(t, err)
+			} else {
+				assertClaimGateHelperAPIError(t, err, tt.forceStatus, tt.forceCode)
+			}
+		})
+	}
+}
+
+func TestIssueLeaseAuthorityRejectsLookupFailureAndArchivedProject(t *testing.T) {
+	ctx := context.Background()
+	store := openClaimGateHelperDB(t)
+	project, _ := createClaimGateHelperIssue(t, store)
+	wrapped := leaseAuthorityTestStore{Storage: store, err: errors.New("lookup failed")}
+	_, _, err := resolveIssueLeaseAuthority(ctx, wrapped, project.ID)
+	require.Error(t, err)
+	_, err = claimBinding(ctx, wrapped, project.ID)
+	require.Error(t, err)
+	require.Error(t, requireHubClaimBinding(ctx, wrapped, project.ID))
+	_, _, err = store.RemoveProject(ctx, db.RemoveProjectParams{ProjectID: project.ID, Actor: "tester", Force: true})
+	require.NoError(t, err)
+	_, _, err = resolveIssueLeaseAuthority(ctx, store, project.ID)
+	assertClaimGateHelperAPIError(t, err, http.StatusNotFound, "project_not_found")
+}
+
+type leaseAuthorityTestStore struct {
+	db.Storage
+	binding db.FederationBinding
+	err     error
+}
+
+func (s leaseAuthorityTestStore) FederationBindingByProject(context.Context, int64) (db.FederationBinding, error) {
+	return s.binding, s.err
+}
