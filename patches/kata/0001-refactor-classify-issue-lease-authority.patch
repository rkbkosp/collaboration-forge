+package daemon
+
+import (
+	"context"
+	"errors"
+
+	"go.kenn.io/kata/internal/db"
+)
+
+// issueLeaseAuthority distinguishes local authority from a spoke's remote hub.
+// Classification alone does not authorize an operation or enable a route.
+type issueLeaseAuthority int
+
+const (
+	leaseAuthorityDisabled issueLeaseAuthority = iota
+	leaseAuthorityStandalone
+	leaseAuthorityHub
+	leaseAuthoritySpoke
+)
+
+func resolveIssueLeaseAuthority(ctx context.Context, store db.Storage, projectID int64) (issueLeaseAuthority, db.FederationBinding, error) {
+	if _, err := activeProjectByID(ctx, store, projectID); err != nil {
+		return leaseAuthorityDisabled, db.FederationBinding{}, err
+	}
+	binding, err := store.FederationBindingByProject(ctx, projectID)
+	if errors.Is(err, db.ErrNotFound) {
+		return leaseAuthorityStandalone, db.FederationBinding{}, nil
+	}
+	if err != nil {
+		return leaseAuthorityDisabled, db.FederationBinding{}, internalAPIError(err)
+	}
+	if binding.Enabled {
+		switch binding.Role {
+		case db.FederationRoleHub:
+			return leaseAuthorityHub, binding, nil
+		case db.FederationRoleSpoke:
+			return leaseAuthoritySpoke, binding, nil
+		}
+	}
+	return leaseAuthorityDisabled, binding, nil
+}
