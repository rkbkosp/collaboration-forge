+package dbtest
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/db"
+	"go.kenn.io/kata/internal/uid"
+)
+
+// Issue-scoped claim operations may expire other claims in the resolved project,
+// but must leave every other project's authoritative or cached claims untouched.
+func checkClaimLazyExpiryProjectIsolation(t *testing.T, _ db.Storage, backend Backend) error {
+	t.Helper()
+	for _, role := range []string{"standalone", "hub"} {
+		t.Run(role, func(t *testing.T) {
+			for _, operation := range []string{"acquire", "renew", "release", "force", "status"} {
+				t.Run(operation, func(t *testing.T) {
+					store := backend.Open(t)
+					t.Cleanup(func() { require.NoError(t, store.Close()) })
+					checkClaimLazyExpiryOperation(t, store, role, operation)
+				})
+			}
+		})
+	}
+	return nil
+}
+
+func checkClaimLazyExpiryOperation(t *testing.T, store db.Storage, role, operation string) {
+	t.Helper()
+	ctx := context.Background()
+	now := time.Date(2026, 7, 16, 12, 0, 0, 0, time.UTC)
+	operationAt := now.Add(2 * time.Hour)
+	principal := db.ClaimPrincipal{
+		HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent",
+	}
+	targetProject, err := store.CreateProject(ctx, "target-project")
+	require.NoError(t, err)
+	spokeProject, err := store.CreateProject(ctx, "spoke-project")
+	require.NoError(t, err)
+	otherProject, err := store.CreateProject(ctx, "other-authoritative-project")
+	require.NoError(t, err)
+	if role == "hub" {
+		_, err = store.EnableProjectFederation(ctx, targetProject.ID, "operator")
+	} else {
+		// Also exclude an unrelated authoritative project of the opposite role.
+		_, err = store.EnableProjectFederation(ctx, otherProject.ID, "operator")
+	}
+	require.NoError(t, err)
+	createIssue := func(project db.Project, title string) db.Issue {
+		t.Helper()
+		issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{
+			ProjectID: project.ID, Title: title, Author: "worker",
+		})
+		require.NoError(t, err)
+		return issue
+	}
+	target := createIssue(targetProject, "target claim operation")
+	sameProject := createIssue(targetProject, "expired claim in target project")
+	spoke := createIssue(spokeProject, "expired cached claim")
+	other := createIssue(otherProject, "expired authoritative claim elsewhere")
+	_, err = store.UpsertFederationBinding(ctx, db.FederationBinding{
+		ProjectID: spokeProject.ID, Role: db.FederationRoleSpoke,
+		HubURL: "https://hub.example", HubProjectID: 42, HubProjectUID: spokeProject.UID,
+		Enabled: true,
+	})
+	require.NoError(t, err)
+	acquire := func(issue db.Issue, ttl time.Duration) {
+		t.Helper()
+		result, err := store.AcquireClaim(ctx, db.AcquireClaimParams{
+			ProjectID: issue.ProjectID, IssueRef: issue.UID, Principal: principal,
+			ClaimKind: "timed", TTL: ttl, Now: now,
+		})
+		require.NoError(t, err)
+		require.True(t, result.Granted)
+		require.Empty(t, result.Events, "fixture setup must not expire claims")
+	}
+	if operation != "acquire" {
+		acquire(target, 4*time.Hour)
+	}
+	acquire(sameProject, time.Hour)
+	acquire(other, time.Hour)
+
+	claimUID, err := uid.New()
+	require.NoError(t, err)
+	remoteInstanceUID, err := uid.New()
+	require.NoError(t, err)
+	remotePrincipal := db.ClaimPrincipal{
+		HolderInstanceUID: remoteInstanceUID, Holder: "remote-worker", ClientKind: "agent",
+	}
+	expiresAt := now.Add(time.Hour)
+	cachedClaim := db.IssueClaim{
+		ClaimUID: claimUID, IssueUID: spoke.UID, Holder: remotePrincipal.Holder,
+		HolderInstanceUID: remotePrincipal.HolderInstanceUID, ClientKind: remotePrincipal.ClientKind,
+		ClaimKind: "timed", Purpose: "cached from hub", AcquiredAt: now,
+		ExpiresAt: &expiresAt, UpdatedAt: now, Revision: 7,
+	}
+	require.NoError(t, store.ApplyClaimStatus(ctx, spokeProject.ID, spoke.UID, db.ClaimStatus{
+		Held: true, Holder: remotePrincipal, Claim: &cachedClaim, HubNow: now,
+	}))
+
+	// Read only, even with a post-expiry clock, so assertions cannot perform the
+	// very lazy expiry being tested or hide mutations of the spoke cache.
+	readStatus := func(issue db.Issue) db.ClaimStatus {
+		t.Helper()
+		status, err := store.ClaimStatusReadOnly(ctx, issue.ProjectID, issue.UID, operationAt)
+		require.NoError(t, err)
+		require.Empty(t, status.Events)
+		return status
+	}
+	spokeBefore := readStatus(spoke)
+	otherBefore := readStatus(other)
+	require.True(t, spokeBefore.Held)
+	require.True(t, otherBefore.Held)
+	require.True(t, readStatus(sameProject).Held)
+	before, err := store.MaxEventID(ctx)
+	require.NoError(t, err)
+
+	var result db.LeaseResult
+	var expiredEvents []db.Event
+	switch operation {
+	case "acquire":
+		result, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+			ProjectID: targetProject.ID, IssueRef: target.ShortID, Principal: principal,
+			ClaimKind: "timed", TTL: time.Hour, Now: operationAt,
+		})
+	case "renew":
+		result, err = store.RenewClaim(ctx, db.RenewClaimParams{
+			ProjectID: targetProject.ID, IssueRef: target.ShortID, Principal: principal,
+			TTL: 3 * time.Hour, Now: operationAt,
+		})
+	case "release":
+		result, err = store.ReleaseClaim(ctx, db.ReleaseClaimParams{
+			ProjectID: targetProject.ID, IssueRef: target.ShortID, Principal: principal,
+			Reason: "complete", Now: operationAt,
+		})
+	case "force":
+		result, err = store.ForceReleaseClaim(ctx, db.ForceReleaseClaimParams{
+			ProjectID: targetProject.ID, IssueRef: target.ShortID, Actor: "operator",
+			Reason: "handoff", Now: operationAt,
+		})
+	case "status":
+		var status db.ClaimStatus
+		status, err = store.ClaimStatus(ctx, targetProject.ID, target.ShortID, operationAt)
+		assert.True(t, status.Held)
+		expiredEvents = status.Events
+	default:
+		t.Fatalf("unknown claim operation %q", operation)
+	}
+	require.NoError(t, err)
+	if operation != "status" {
+		assert.True(t, result.Granted)
+		expiredEvents = result.Events
+	}
+
+	assert.False(t, readStatus(sameProject).Held, "other expired claim in target project must be cleared")
+	assert.Equal(t, spokeBefore, readStatus(spoke), "spoke cache must remain unchanged")
+	assert.Equal(t, otherBefore, readStatus(other), "unrelated authoritative claim must remain unchanged")
+	assert.Len(t, expiredEvents, 1, "only the target project's expiry event may be returned")
+	var returnedUIDs []string
+	for _, event := range expiredEvents {
+		assert.Equal(t, "claim.expired", event.Type)
+		assert.Equal(t, "system", event.Actor)
+		assert.Equal(t, targetProject.ID, event.ProjectID)
+		assert.Equal(t, &sameProject.UID, event.IssueUID)
+		returnedUIDs = append(returnedUIDs, event.UID)
+	}
+	events, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: before, Limit: 100})
+	require.NoError(t, err)
+	var persistedUIDs []string
+	for _, event := range events {
+		assert.Equal(t, targetProject.ID, event.ProjectID, "no event may be written in other projects")
+		if event.Type == "claim.expired" {
+			assert.Equal(t, &sameProject.UID, event.IssueUID)
+			persistedUIDs = append(persistedUIDs, event.UID)
+		}
+	}
+	assert.Len(t, persistedUIDs, 1, "exactly one same-project expiry must be persisted")
+	assert.Equal(t, returnedUIDs, persistedUIDs, "returned expiry must be the durable event")
+}
