+	"go.kenn.io/kata/internal/testenv"
+)
+
+func createStandaloneClaimIssue(t *testing.T, env *testenv.Env) (db.Project, db.Issue) {
+	t.Helper()
+	project, err := env.DB.CreateProject(context.Background(), "standalone-project")
+	require.NoError(t, err)
+	issue, _, err := env.DB.CreateIssue(context.Background(), db.CreateIssueParams{ProjectID: project.ID, Title: "lease lifecycle", Author: "tester"})
+	require.NoError(t, err)
+	return project, issue
+}
+
+func TestStandaloneLeaseLifecycle(t *testing.T) {
+	for _, kind := range []string{"hard", "timed"} {
+		t.Run(kind, func(t *testing.T) {
+			env := testenv.New(t, testenv.WithAuthToken("admin-token"))
+			project, issue := createStandaloneClaimIssue(t, env)
+			headers := bearer("admin-token")
+			body := map[string]any{"holder": "agent-a", "client_kind": "cli", "claim_kind": kind, "ttl_seconds": 120}
+			var acquired claimResponseBody
+			resp := claimPost(t, env, project.ID, issue.ShortID, "claim", body, headers, &acquired)
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+			require.True(t, acquired.Granted)
+			require.NotNil(t, acquired.Claim)
+			assert.Equal(t, kind, acquired.Claim.ClaimKind)
+			var repeated claimResponseBody
+			resp = claimPost(t, env, project.ID, issue.ShortID, "claim", body, headers, &repeated)
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+			require.True(t, repeated.Granted)
+			require.NotNil(t, repeated.Claim)
+			assert.Equal(t, acquired.Claim.ClaimUID, repeated.Claim.ClaimUID)
+			var denied claimResponseBody
+			resp = claimPost(t, env, project.ID, issue.ShortID, "claim", map[string]any{"holder": "agent-b", "client_kind": "cli", "claim_kind": "hard"}, headers, &denied)
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+			assert.False(t, denied.Granted, "retain existing grant/deny wire semantics")
+			require.NotNil(t, denied.Claim)
+			assert.Equal(t, acquired.Claim.ClaimUID, denied.Claim.ClaimUID)
+			resp, raw := envDoRaw(t, env, http.MethodGet, claimStatusPath(project.ID, issue.ShortID), nil, headers)
+			require.Equal(t, http.StatusOK, resp.StatusCode, string(raw))
+			var status claimStatusBody
+			require.NoError(t, json.Unmarshal(raw, &status))
+			require.True(t, status.Held)
+			require.NotNil(t, status.Claim)
+			assert.Equal(t, acquired.Claim.ClaimUID, status.Claim.ClaimUID)
+			assert.False(t, status.HubNow.IsZero())
+			for _, action := range []string{"renew", "release"} {
+				resp, raw = envDoRaw(t, env, http.MethodPost, claimActionPath(project.ID, issue.ShortID, action), map[string]any{"holder": "agent-b", "client_kind": "cli", "ttl_seconds": 300}, headers)
+				assertAPIError(t, resp.StatusCode, raw, http.StatusConflict, "claim_not_held")
+			}
+			if kind == "timed" {
+				var renewed claimResponseBody
+				resp = claimPost(t, env, project.ID, issue.ShortID, "renew", map[string]any{"holder": "agent-a", "client_kind": "cli", "ttl_seconds": 300}, headers, &renewed)
+				require.Equal(t, http.StatusOK, resp.StatusCode)
+				require.NotNil(t, renewed.Claim)
+				assert.Equal(t, acquired.Claim.ClaimUID, renewed.Claim.ClaimUID)
+				require.NotNil(t, renewed.Claim.ExpiresAt)
+				require.NotNil(t, acquired.Claim.ExpiresAt)
+				assert.True(t, renewed.Claim.ExpiresAt.After(*acquired.Claim.ExpiresAt))
+			}
+			var released claimResponseBody
+			resp = claimPost(t, env, project.ID, issue.ShortID, "release", body, headers, &released)
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+			require.NotNil(t, released.Event)
+			assert.Equal(t, "claim.released", released.Event.Type)
+			resp, raw = envDoRaw(t, env, http.MethodGet, claimStatusPath(project.ID, issue.ShortID), nil, headers)
+			require.Equal(t, http.StatusOK, resp.StatusCode, string(raw))
+			status = claimStatusBody{}
+			require.NoError(t, json.Unmarshal(raw, &status))
+			assert.False(t, status.Held)
+		})
+	}
+}
+
+func TestStandaloneForceReleasePreservesAdminAuthentication(t *testing.T) {
+	env := testenv.New(t, testenv.WithAuthToken("admin-token"))
+	project, issue := createStandaloneClaimIssue(t, env)
+	hub, _ := createClaimHubIssue(t, env)
+	enrollment := createClaimEnrollment(t, env, hub.ID, federationTestSpokeUID, "claim")
+	var acquired claimResponseBody
+	resp := claimPost(t, env, project.ID, issue.ShortID, "claim", map[string]any{"holder": "agent-a", "claim_kind": "hard"}, bearer("admin-token"), &acquired)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.NotNil(t, acquired.Claim)
+	for _, token := range []string{"", "wrong-token", enrollment.Token} {
+		var headers map[string]string
+		if token != "" {
+			headers = bearer(token)
+		}
+		resp, _ := envDoRaw(t, env, http.MethodPost, claimActionPath(project.ID, issue.ShortID, "force_release"), map[string]any{"actor": "admin"}, headers)
+		assert.Contains(t, []int{http.StatusUnauthorized, http.StatusForbidden}, resp.StatusCode)
+		status, err := env.DB.ClaimStatusReadOnly(context.Background(), project.ID, issue.ShortID, time.Now())
+		require.NoError(t, err)
+		require.NotNil(t, status.Claim)
+		assert.Equal(t, acquired.Claim.ClaimUID, status.Claim.ClaimUID)
+	}
+	var released claimResponseBody
+	resp = claimPost(t, env, project.ID, issue.ShortID, "force_release", map[string]any{"actor": "admin"}, bearer("admin-token"), &released)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.NotNil(t, released.Event)
+	assert.Equal(t, "claim.force_released", released.Event.Type)
+	require.NotNil(t, released.Claim)
+	assert.NotNil(t, released.Claim.ReleasedAt)
+}
+
+func TestSpokeForceReleaseStillRefused(t *testing.T) {
+	hub, spoke, hubProject, spokeProject, issue, token := createClaimForwardingPair(t, "claim")
+	require.NoError(t, config.WriteFederationCredential(spokeProject.UID, config.FederationCredential{
+		HubURL: hub.URL, HubProjectID: hubProject.ID, Token: token, Capabilities: "claim",
+	}))
+	var acquired claimResponseBody
+	resp := claimPost(t, spoke, spokeProject.ID, issue.ShortID, "claim", map[string]any{"holder": "agent-a", "client_kind": "cli", "claim_kind": "hard"}, nil, &acquired)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.NotNil(t, acquired.Claim)
+	resp, raw := envDoRaw(t, spoke, http.MethodPost, claimActionPath(spokeProject.ID, issue.ShortID, "force_release"), map[string]any{"actor": "admin"}, nil)
+	assertAPIError(t, resp.StatusCode, raw, http.StatusConflict, "federated_read_only")
+	for _, target := range []struct {
+		env       *testenv.Env
+		projectID int64
+	}{{hub, hubProject.ID}, {spoke, spokeProject.ID}} {
+		status, err := target.env.DB.ClaimStatusReadOnly(context.Background(), target.projectID, issue.UID, time.Now())
+		require.NoError(t, err)
+		require.NotNil(t, status.Claim)
+		assert.Equal(t, acquired.Claim.ClaimUID, status.Claim.ClaimUID)
+	}
+}
+
+func TestStandaloneLeaseRoutesRequireAuthentication(t *testing.T) {
+	env := testenv.New(t, testenv.WithAuthToken("admin-token"))
+	project, issue := createStandaloneClaimIssue(t, env)
+	for _, action := range []string{"claim", "renew", "release", "force_release"} {
+		resp := claimPost(t, env, project.ID, issue.ShortID, action, map[string]any{"holder": "agent-a"}, nil, nil)
+		assert.Equal(t, http.StatusUnauthorized, resp.StatusCode)
+	}
+	resp, raw := envDoRaw(t, env, http.MethodGet, claimStatusPath(project.ID, issue.ShortID), nil, nil)
+	assertAPIError(t, resp.StatusCode, raw, http.StatusUnauthorized, "auth_required")
+}
