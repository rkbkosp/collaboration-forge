diff --git a/internal/daemon/handlers_show_standalone_leases_test.go b/internal/daemon/handlers_show_standalone_leases_test.go
new file mode 100644
index 0000000..a1e385c
--- /dev/null
+++ b/internal/daemon/handlers_show_standalone_leases_test.go
@@ -0,0 +1,126 @@
+package daemon_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/api"
+	"go.kenn.io/kata/internal/daemon"
+	"go.kenn.io/kata/internal/db"
+	"go.kenn.io/kata/internal/testenv"
+)
+
+func TestShowIssueStandaloneLease(t *testing.T) {
+	for _, route := range []string{"short_id", "project_uid", "global_uid"} {
+		for _, state := range []string{"hard", "timed", "expired", "none"} {
+			t.Run(route+"/"+state, func(t *testing.T) {
+				env := testenv.New(t)
+				project, issue := createStandaloneClaimIssue(t, env)
+				var acquired *db.IssueClaim
+				if state != "none" {
+					kind := state
+					acquiredAt := time.Now().UTC()
+					if state == "expired" {
+						kind = "timed"
+						acquiredAt = acquiredAt.Add(-2 * time.Minute)
+					}
+					result, err := env.DB.AcquireClaim(context.Background(), db.AcquireClaimParams{
+						ProjectID: project.ID,
+						IssueRef:  issue.ShortID,
+						Principal: db.ClaimPrincipal{
+							HolderInstanceUID: env.DB.InstanceUID(),
+							Holder:            "local-agent",
+							ClientKind:        "cli",
+						},
+						ClaimKind: kind,
+						TTL:       time.Minute,
+						Now:       acquiredAt,
+					})
+					require.NoError(t, err)
+					require.True(t, result.Granted)
+					require.NotNil(t, result.Claim)
+					acquired = result.Claim
+					assertShowLiveClaimCount(t, env.DB, issue.UID, 1)
+				}
+				assertShowEventCount(t, env.DB, "claim.expired", 0)
+				sub := env.Broadcaster.Subscribe(daemon.SubFilter{ProjectID: project.ID})
+				defer sub.Unsub()
+
+				path := issuePathRef(project.ID, issue.ShortID, "")
+				switch route {
+				case "project_uid":
+					path = issuePathRef(project.ID, issue.UID, "")
+				case "global_uid":
+					path = "/api/v1/issues/" + issue.UID
+				}
+				beforeShow := time.Now().UTC()
+				resp, raw := envDoRaw(t, env, http.MethodGet, path, nil, nil)
+				afterShow := time.Now().UTC()
+				require.Equal(t, http.StatusOK, resp.StatusCode, string(raw))
+				var body struct {
+					Issue       db.Issue           `json:"issue"`
+					Lease       *api.IssueClaimOut `json:"lease"`
+					LeaseHubNow *time.Time         `json:"lease_hub_now"`
+				}
+				require.NoError(t, json.Unmarshal(raw, &body))
+				assert.Equal(t, issue.UID, body.Issue.UID)
+				var fields map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(raw, &fields))
+				for _, field := range []string{
+					"pending_leases", "pending_claims", "lease_violations", "claim_violations",
+					"lease_violation_count", "claim_violation_count",
+				} {
+					assert.NotContains(t, fields, field)
+				}
+
+				if state == "hard" || state == "timed" {
+					require.NotNil(t, body.Lease, "standalone live lease must appear in show")
+					assert.Equal(t, acquired.ClaimUID, body.Lease.ClaimUID)
+					assert.Equal(t, issue.UID, body.Lease.IssueUID)
+					assert.Equal(t, project.ID, body.Lease.ProjectID)
+					assert.Equal(t, "local-agent", body.Lease.Holder)
+					assert.Equal(t, env.DB.InstanceUID(), body.Lease.HolderInstanceUID)
+					assert.Equal(t, state, body.Lease.ClaimKind)
+					assert.Nil(t, body.Lease.ReleasedAt)
+					require.NotNil(t, body.LeaseHubNow)
+					assert.WithinRange(t, *body.LeaseHubNow, beforeShow, afterShow)
+					if state == "timed" {
+						require.NotNil(t, body.Lease.ExpiresAt)
+						assert.True(t, body.Lease.ExpiresAt.After(*body.LeaseHubNow))
+					} else {
+						assert.Nil(t, body.Lease.ExpiresAt)
+					}
+					assert.JSONEq(t, string(fields["lease"]), string(fields["claim"]))
+					assert.JSONEq(t, string(fields["lease_hub_now"]), string(fields["claim_hub_now"]))
+					assertShowLiveClaimCount(t, env.DB, issue.UID, 1)
+					assertShowEventCount(t, env.DB, "claim.expired", 0)
+					return
+				}
+
+				assert.Nil(t, body.Lease)
+				assert.Nil(t, body.LeaseHubNow)
+				for _, field := range []string{"lease", "claim", "lease_hub_now", "claim_hub_now"} {
+					assert.NotContains(t, fields, field)
+				}
+				assertShowLiveClaimCount(t, env.DB, issue.UID, 0)
+				if state == "expired" {
+					assertShowEventCount(t, env.DB, "claim.expired", 1)
+					msg := receiveMsg(t, sub.Ch, time.Second, "standalone show should broadcast committed lease expiry")
+					require.NotNil(t, msg.Event)
+					assert.Equal(t, "claim.expired", msg.Event.Type)
+					assert.Equal(t, project.ID, msg.Event.ProjectID)
+					resp, raw = envDoRaw(t, env, http.MethodGet, path, nil, nil)
+					require.Equal(t, http.StatusOK, resp.StatusCode, string(raw))
+					assertShowEventCount(t, env.DB, "claim.expired", 1)
+				} else {
+					assertShowEventCount(t, env.DB, "claim.expired", 0)
+				}
+			})
+		}
+	}
+}
