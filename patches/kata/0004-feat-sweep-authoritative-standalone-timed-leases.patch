+func (s *TimedClaimSweeper) expireAuthoritativeProject(ctx context.Context, projectID int64, now time.Time, limit int) ([]db.Event, error) {
+	// Serialize classification and expiry with federation endpoint transitions;
+	// a spoke's cache must not become a sweep target from an outdated snapshot.
+	finish, err := beginClaimFederationTransport(ctx, ServerConfig{DB: s.DB}, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer finish()
+	authority, _, err := resolveIssueLeaseAuthority(ctx, s.DB, projectID)
+	if err != nil {
+		return nil, err
+	}
+	if authority != leaseAuthorityStandalone && authority != leaseAuthorityHub {
+		return nil, nil
+	}
+	return s.DB.ExpireTimedClaimsForProject(ctx, projectID, now, limit)
+}
