+package daemon_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/daemon"
+	"go.kenn.io/kata/internal/db"
+	"go.kenn.io/kata/internal/testenv"
+)
+
+func TestTimedClaimSweeperAuthority(t *testing.T) {
+	for _, role := range []string{"standalone", "hub", "spoke", "disabled", "archived"} {
+		t.Run(role, func(t *testing.T) {
+			ctx := context.Background()
+			env := testenv.New(t)
+			project, issue := createStandaloneClaimIssue(t, env)
+			now := time.Now().UTC()
+			if role == "hub" || role == "disabled" {
+				_, err := env.DB.EnableProjectFederation(ctx, project.ID, "operator")
+				require.NoError(t, err)
+				if role == "disabled" {
+					binding, err := env.DB.FederationBindingByProject(ctx, project.ID)
+					require.NoError(t, err)
+					binding.Enabled = false
+					_, err = env.DB.UpsertFederationBinding(ctx, binding)
+					require.NoError(t, err)
+				}
+			}
+			if role == "spoke" {
+				_, err := env.DB.UpsertFederationBinding(ctx, db.FederationBinding{ProjectID: project.ID, Role: db.FederationRoleSpoke, HubURL: "https://hub.example", HubProjectID: 42, HubProjectUID: project.UID, Enabled: true})
+				require.NoError(t, err)
+			}
+			acquired, err := env.DB.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: db.ClaimPrincipal{Holder: "worker", HolderInstanceUID: env.DB.InstanceUID(), ClientKind: "agent"}, ClaimKind: "timed", TTL: time.Minute, Now: now.Add(-2 * time.Minute)})
+			require.NoError(t, err)
+			require.NotNil(t, acquired.Claim)
+			if role == "archived" {
+				_, _, err = env.DB.RemoveProject(ctx, db.RemoveProjectParams{ProjectID: project.ID, Actor: "operator", Force: true})
+				require.NoError(t, err)
+			}
+			sink := &captureHookSink{}
+			sweeper := daemon.NewTimedClaimSweeper(env.DB, daemon.NewEventPublisher(nil, sink))
+			require.NoError(t, sweeper.RunOnce(ctx, now))
+			var released bool
+			require.NoError(t, env.DB.QueryRowContext(ctx, `SELECT released_at IS NOT NULL FROM issue_claims WHERE claim_uid = ?`, acquired.Claim.ClaimUID).Scan(&released))
+			authoritative := role == "standalone" || role == "hub"
+			assert.Equal(t, authoritative, released)
+			if authoritative {
+				require.Len(t, sink.events, 1)
+				assert.Equal(t, "claim.expired", sink.events[0].Type)
+				assert.Equal(t, project.ID, sink.events[0].ProjectID)
+				require.NoError(t, sweeper.RunOnce(ctx, now))
+				assert.Len(t, sink.events, 1, "expiry emitted once")
+			} else {
+				assert.Empty(t, sink.events)
+			}
+		})
+	}
+}
