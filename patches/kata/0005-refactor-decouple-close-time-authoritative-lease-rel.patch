+// releaseLiveAuthoritativeClaimOnCloseTx is close lifecycle cleanup, not a
+// federation violation audit. No binding means local authority; only an enabled
+// hub binding retains it. Spoke caches and disabled bindings stay untouched.
+func (s *Store) releaseLiveAuthoritativeClaimOnCloseTx(
+	ctx context.Context,
+	tx *sql.Tx,
+	project db.Project,
+	issue db.Issue,
+	actor string,
+) (*db.Event, error) {
+	var authoritative bool
+	if err := tx.QueryRowContext(ctx, `SELECT NOT EXISTS (
+		SELECT 1 FROM federation_bindings
+		 WHERE project_id=$1 AND (enabled != 1 OR role != $2))`,
+		project.ID, string(db.FederationRoleHub)).Scan(&authoritative); err != nil {
+		return nil, mapSQLError(err, nil)
+	}
+	if !authoritative {
+		return nil, nil
+	}
+	live, err := claimForIssueTx(ctx, tx, issue.UID, true)
+	if errors.Is(err, db.ErrNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	now := time.Now().UTC()
+	// Unreleased is not necessarily live. Leave expired leases to the existing
+	// expiry paths rather than reporting them as released by this close.
+	if claimTimedExpired(live, now) {
+		return nil, nil
+	}
+	_, event, err := s.releaseClaimTx(ctx, tx, project, issue, live,
+		"claim.released", actor, "issue_closed", now)
+	if err != nil {
+		return nil, err
+	}
+	return &event, nil
+}
