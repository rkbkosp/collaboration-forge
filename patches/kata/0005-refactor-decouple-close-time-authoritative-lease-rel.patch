+func checkClaimCloseIngest(t *testing.T, store db.Storage) error {
+	ctx := context.Background()
+	project, err := store.CreateProject(ctx, "ingest-close-hub")
+	require.NoError(t, err)
+	_, err = store.EnableProjectFederation(ctx, project.ID, "operator")
+	require.NoError(t, err)
+	spokeUID, err := uid.New()
+	require.NoError(t, err)
+	for index, holder := range []string{"sync-worker", "other-worker"} {
+		t.Run(holder, func(t *testing.T) {
+			issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{
+				ProjectID: project.ID, Title: "remote close", Author: "worker",
+			})
+			require.NoError(t, err)
+			_, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+				ProjectID: project.ID, IssueRef: issue.UID, ClaimKind: "hard",
+				Principal: db.ClaimPrincipal{HolderInstanceUID: spokeUID, Holder: holder, ClientKind: "agent"},
+			})
+			require.NoError(t, err)
+			cursor, err := store.MaxEventID(ctx)
+			require.NoError(t, err)
+			remote := newRemoteEvent(t, project, &issue.UID, "issue.closed", "sync-worker", spokeUID,
+				time.Now().Add(time.Hour).UnixMilli(), json.RawMessage(`{"reason":"done","closed_at":"2026-07-01T12:00:00.000Z"}`))
+			params := db.FederationIngestParams{
+				ProjectID: project.ID, SpokeInstanceUID: spokeUID, BoundActor: "sync-worker",
+				Events: []db.FederationIngestEvent{{SourceEventID: int64(index + 1), Event: remote}},
+			}
+			result, err := store.IngestFederationEvents(ctx, params)
+			require.NoError(t, err)
+			assert.Equal(t, 1, result.Accepted)
+			events, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+			require.NoError(t, err)
+			want := []string{"issue.closed"}
+			if holder != "sync-worker" {
+				want = append(want, "claim.violated")
+			}
+			want = append(want, "claim.released")
+			assert.Equal(t, want, eventTypeNames(events))
+			assert.Equal(t, eventUIDs(events), result.InsertedEventUIDs)
+			status, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			assert.False(t, status.Held)
+			closed, err := store.IssueByID(ctx, issue.ID)
+			require.NoError(t, err)
+			assert.Equal(t, "closed", closed.Status)
+			retry, err := store.IngestFederationEvents(ctx, params)
+			require.NoError(t, err)
+			assert.Equal(t, 1, retry.Duplicates)
+			assert.Empty(t, retry.InsertedEventUIDs)
+		})
+	}
+	return nil
+}
+
+func eventUIDs(events []db.Event) []string {
+	uids := make([]string, len(events))
+	for index, event := range events {
+		uids[index] = event.UID
+	}
+	return uids
+}
