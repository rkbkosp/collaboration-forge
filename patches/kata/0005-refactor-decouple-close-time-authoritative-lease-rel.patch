+func checkClaimCloseRecurrence(t *testing.T, store db.Storage) error {
+	ctx := context.Background()
+	for _, role := range []string{"standalone", "hub"} {
+		t.Run(role, func(t *testing.T) {
+			project, err := store.CreateProject(ctx, "recurring-close-"+role)
+			require.NoError(t, err)
+			if role == "hub" {
+				_, err = store.EnableProjectFederation(ctx, project.ID, "operator")
+				require.NoError(t, err)
+			}
+			rec, _, err := store.CreateRecurrence(ctx, db.CreateRecurrenceIn{
+				ProjectID: project.ID, Actor: "worker", Rule: "FREQ=DAILY", DTStart: "2026-07-01",
+				Timezone: "UTC", Template: db.RecurrenceTemplate{Title: "recurring claimed work"},
+			})
+			require.NoError(t, err)
+			occurrence, err := store.MaterializeNext(ctx, rec.ID, "2026-07-01", "worker")
+			require.NoError(t, err)
+			_, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+				ProjectID: project.ID, IssueRef: occurrence.NewIssueUID, ClaimKind: "hard",
+				Principal: db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"},
+			})
+			require.NoError(t, err)
+			cursor, err := store.MaxEventID(ctx)
+			require.NoError(t, err)
+			_, events, changed, err := store.CloseIssueWithEvents(
+				ctx, occurrence.NewIssueID, "done", "other-worker", "completed", nil,
+			)
+			require.NoError(t, err)
+			assert.True(t, changed)
+			want := []string{"issue.closed"}
+			if role == "hub" {
+				want = append(want, "claim.violated")
+			}
+			want = append(want, "claim.released", "issue.created", "recurrence.materialized")
+			assert.Equal(t, want, eventTypeNames(events))
+			durable, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+			require.NoError(t, err)
+			assert.Equal(t, eventUIDs(durable), eventUIDs(events), "release must not be duplicated when loading recurrence events")
+		})
+	}
+	return nil
+}
+
+func checkClaimCloseRefusal(t *testing.T, store db.Storage) error {
+	ctx := context.Background()
+	for _, role := range []string{"standalone", "hub"} {
+		for _, kind := range []string{"hard", "timed"} {
+			t.Run(role+"/"+kind, func(t *testing.T) {
+				project, err := store.CreateProject(ctx, "refused-close-"+role+"-"+kind)
+				require.NoError(t, err)
+				if role == "hub" {
+					_, err = store.EnableProjectFederation(ctx, project.ID, "operator")
+					require.NoError(t, err)
+				}
+				parent, _, err := store.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "parent", Author: "worker"})
+				require.NoError(t, err)
+				_, _, err = store.CreateIssue(ctx, db.CreateIssueParams{
+					ProjectID: project.ID, Title: "open child", Author: "worker",
+					Links: []db.InitialLink{{Type: "parent", ToNumber: parent.ID}},
+				})
+				require.NoError(t, err)
+				ttl := time.Duration(0)
+				if kind == "timed" {
+					ttl = time.Hour
+				}
+				_, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+					ProjectID: project.ID, IssueRef: parent.UID, ClaimKind: kind, TTL: ttl,
+					Principal: db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"},
+				})
+				require.NoError(t, err)
+				before, err := store.ClaimStatusReadOnly(ctx, project.ID, parent.UID, time.Now())
+				require.NoError(t, err)
+				cursor, err := store.MaxEventID(ctx)
+				require.NoError(t, err)
+				_, _, _, err = store.CloseIssueWithEvents(ctx, parent.ID, "done", "worker", "not ready", nil)
+				require.ErrorIs(t, err, db.ErrOpenChildren)
+				after, err := store.ClaimStatusReadOnly(ctx, project.ID, parent.UID, time.Now())
+				require.NoError(t, err)
+				assert.True(t, after.Held)
+				assert.Equal(t, before.Claim, after.Claim)
+				unchanged, err := store.IssueByID(ctx, parent.ID)
+				require.NoError(t, err)
+				assert.Equal(t, "open", unchanged.Status)
+				events, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+				require.NoError(t, err)
+				assert.Empty(t, events)
+			})
+		}
+	}
+	return nil
+}
