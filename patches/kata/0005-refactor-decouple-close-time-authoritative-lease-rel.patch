+// Failure after the lease row was released must roll back the close, audit,
+// and lease update together, not strand a closed issue or a released lease.
+func checkClaimCloseRollback(t *testing.T, store db.Storage, backend Backend) error {
+	ctx := context.Background()
+	require.NotNil(t, backend.InstallClaimReleaseFailure)
+	for _, role := range []string{"standalone", "hub"} {
+		for _, kind := range []string{"hard", "timed"} {
+			t.Run(role+"/"+kind, func(t *testing.T) {
+				project, err := store.CreateProject(ctx, "rollback-close-"+role+"-"+kind)
+				require.NoError(t, err)
+				if role == "hub" {
+					_, err = store.EnableProjectFederation(ctx, project.ID, "operator")
+					require.NoError(t, err)
+				}
+				issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{
+					ProjectID: project.ID, Title: "atomic close", Author: "worker",
+				})
+				require.NoError(t, err)
+				ttl := time.Duration(0)
+				if kind == "timed" {
+					ttl = time.Hour
+				}
+				_, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+					ProjectID: project.ID, IssueRef: issue.UID, ClaimKind: kind, TTL: ttl,
+					Principal: db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"},
+				})
+				require.NoError(t, err)
+				before, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+				require.NoError(t, err)
+				cursor, err := store.MaxEventID(ctx)
+				require.NoError(t, err)
+				removeFailure, err := backend.InstallClaimReleaseFailure(ctx, store)
+				require.NoError(t, err)
+				defer func() { require.NoError(t, removeFailure()) }()
+				_, _, _, err = store.CloseIssueWithEvents(ctx, issue.ID, "done", "other-worker", "completed", nil)
+				require.Error(t, err, "close must fail when its release event cannot be inserted")
+				after, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+				require.NoError(t, err)
+				assert.True(t, after.Held)
+				assert.Equal(t, before.Claim, after.Claim)
+				unchanged, err := store.IssueByID(ctx, issue.ID)
+				require.NoError(t, err)
+				assert.Equal(t, issue, unchanged)
+				events, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+				require.NoError(t, err)
+				assert.Empty(t, events)
+			})
+		}
+	}
+	return nil
+}
