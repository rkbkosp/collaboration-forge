+// Closing work releases only a live lease for which this store is authoritative.
+// Standalone close must not opt into federation's uncovered-work audit policy.
+func checkClaimCloseAuthority(t *testing.T, store db.Storage) error {
+	ctx := context.Background()
+	for _, role := range []string{"standalone", "hub", "spoke", "disabled-hub", "disabled-spoke"} {
+		for _, kind := range []string{"hard", "timed", "expired"} {
+			t.Run(role+"/"+kind, func(t *testing.T) {
+				project, err := store.CreateProject(ctx, "close-"+role+"-"+kind)
+				require.NoError(t, err)
+				issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{
+					ProjectID: project.ID, Title: "claimed close", Author: "worker",
+				})
+				require.NoError(t, err)
+				if role != "standalone" {
+					bindingRole := db.FederationRoleHub
+					if role == "spoke" || role == "disabled-spoke" {
+						bindingRole = db.FederationRoleSpoke
+					}
+					_, err = store.UpsertFederationBinding(ctx, db.FederationBinding{
+						ProjectID: project.ID, Role: bindingRole, HubProjectUID: project.UID,
+						HubURL: "https://hub.example", HubProjectID: 42,
+						Enabled: role == "hub" || role == "spoke", PushEnabled: true, Actor: "other-worker",
+					})
+					require.NoError(t, err)
+				}
+				now := time.Now().UTC()
+				acquiredAt, claimKind := now, kind
+				if kind == "expired" {
+					acquiredAt, claimKind = now.Add(-2*time.Hour), "timed"
+				}
+				principal := db.ClaimPrincipal{
+					HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent",
+				}
+				if role == "spoke" || role == "disabled-spoke" {
+					claimUID, err := uid.New()
+					require.NoError(t, err)
+					principal.HolderInstanceUID, err = uid.New()
+					require.NoError(t, err)
+					cached := db.IssueClaim{
+						ClaimUID: claimUID, IssueUID: issue.UID, Holder: principal.Holder,
+						HolderInstanceUID: principal.HolderInstanceUID, ClientKind: principal.ClientKind,
+						ClaimKind: claimKind, AcquiredAt: acquiredAt, UpdatedAt: acquiredAt, Revision: 7,
+					}
+					if claimKind == "timed" {
+						expiresAt := acquiredAt.Add(time.Hour)
+						cached.ExpiresAt = &expiresAt
+					}
+					require.NoError(t, store.ApplyClaimStatus(ctx, project.ID, issue.UID, db.ClaimStatus{
+						Held: true, Holder: principal, Claim: &cached, HubNow: acquiredAt,
+					}))
+				} else {
+					ttl := time.Duration(0)
+					if claimKind == "timed" {
+						ttl = time.Hour
+					}
+					_, err = store.AcquireClaim(ctx, db.AcquireClaimParams{
+						ProjectID: project.ID, IssueRef: issue.UID, Principal: principal,
+						ClaimKind: claimKind, TTL: ttl, Now: acquiredAt,
+					})
+					require.NoError(t, err)
+				}
+				before, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, now)
+				require.NoError(t, err)
+				require.True(t, before.Held)
+				cursor, err := store.MaxEventID(ctx)
+				require.NoError(t, err)
+				closed, events, changed, err := store.CloseIssueWithEvents(
+					ctx, issue.ID, "done", "other-worker", "completed", nil,
+				)
+				require.NoError(t, err)
+				assert.True(t, changed)
+				assert.Equal(t, "closed", closed.Status)
+				want := []string{"issue.closed"}
+				releases := (role == "standalone" || role == "hub") && kind != "expired"
+				if role == "hub" && kind != "expired" {
+					want = append(want, "claim.violated")
+				}
+				if releases {
+					want = append(want, "claim.released")
+				} else if role == "hub" && kind == "expired" {
+					want = append(want, "claim.expired")
+				}
+				assert.Equal(t, want, eventTypeNames(events))
+				durable, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+				require.NoError(t, err)
+				assert.Equal(t, eventUIDs(events), eventUIDs(durable))
+				after, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, now)
+				require.NoError(t, err)
+				if releases || (role == "hub" && kind == "expired") {
+					assert.False(t, after.Held)
+				} else {
+					assert.True(t, after.Held)
+					assert.Equal(t, before.Claim, after.Claim, "cached or expired standalone claims stay unchanged")
+				}
+				if releases && len(events) == len(want) {
+					var payload struct {
+						ClaimUID string `json:"claim_uid"`
+						Reason   string `json:"reason"`
+					}
+					released := events[len(events)-1]
+					require.NoError(t, json.Unmarshal([]byte(released.Payload), &payload))
+					assert.Equal(t, before.Claim.ClaimUID, payload.ClaimUID)
+					assert.Equal(t, "issue_closed", payload.Reason)
+					assert.Equal(t, "other-worker", released.Actor)
+				}
+				_, repeatedEvents, repeatedChanged, err := store.CloseIssueWithEvents(
+					ctx, issue.ID, "done", "other-worker", "retry", nil,
+				)
+				require.NoError(t, err)
+				assert.False(t, repeatedChanged)
+				assert.Empty(t, repeatedEvents)
+			})
+		}
+	}
+	return nil
+}
