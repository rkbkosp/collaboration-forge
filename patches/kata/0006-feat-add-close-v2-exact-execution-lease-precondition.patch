+// The close is already in flight, paused at its real transaction fence. A
+// separate transaction releases/reacquires the same principal's tenure before
+// the close resolves the issue. An out-of-transaction precheck would accept
+// the stale token. Repeat both hard and timed variants without scheduling luck.
+func checkClaimGuardConcurrentFence(t *testing.T, store db.Storage) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	project, err := store.CreateProject(ctx, "guard-fence")
+	require.NoError(t, err)
+	principal := db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"}
+	for n := 0; n < 6; n++ {
+		t.Run(fmt.Sprint(n), func(t *testing.T) {
+			issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "replace tenure", Author: "worker"})
+			require.NoError(t, err)
+			kind, ttl := "hard", time.Duration(0)
+			if n%2 == 1 {
+				kind, ttl = "timed", time.Hour
+			}
+			acquire := db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: principal, ClaimKind: kind, TTL: ttl}
+			first, err := store.AcquireClaim(ctx, acquire)
+			require.NoError(t, err)
+			entered, proceed := make(chan struct{}), make(chan struct{})
+			var once sync.Once
+			defer once.Do(func() { close(proceed) })
+			attempts := 0
+			fenced := db.WithTransactionFence(ctx, func(ctx context.Context, tx db.Transaction) error {
+				attempts++
+				// Freeze a real read snapshot before the concurrent replacement.
+				// Both engines must retry this snapshot, then reject the old UID.
+				var id int64
+				if err := tx.QueryRowContext(ctx, `SELECT id FROM issues WHERE id=$1`, issue.ID).Scan(&id); err != nil {
+					return err
+				}
+				select {
+				case <-entered:
+				default:
+					close(entered)
+				}
+				select {
+				case <-proceed:
+					return nil
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			})
+			type result struct {
+				events  []db.Event
+				changed bool
+				err     error
+			}
+			finished := make(chan result, 1)
+			go func() {
+				_, events, changed, err := store.CloseIssueGuarded(fenced, db.CloseIssueParams{IssueID: issue.ID, Reason: "done", Actor: "worker", ClaimGuard: &db.ClaimGuard{Required: true, ExpectedClaimUID: first.Claim.ClaimUID, Principal: principal}})
+				finished <- result{events, changed, err}
+			}()
+			select {
+			case <-entered:
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			}
+			_, err = store.ReleaseClaim(ctx, db.ReleaseClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: principal})
+			require.NoError(t, err)
+			second, err := store.AcquireClaim(ctx, acquire)
+			require.NoError(t, err)
+			require.NotEqual(t, first.Claim.ClaimUID, second.Claim.ClaimUID)
+			before, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			cursor, err := store.MaxEventID(ctx)
+			require.NoError(t, err)
+			once.Do(func() { close(proceed) })
+			select {
+			case result := <-finished:
+				require.ErrorIs(t, result.err, db.ErrClaimLost)
+				assert.False(t, result.changed)
+				assert.Empty(t, result.events)
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			}
+			assert.GreaterOrEqual(t, attempts, 2, "stale snapshot must retry the whole transaction")
+			assertClaimGuardUnchanged(t, store, issue, before, cursor)
+			_, events, changed, err := store.CloseIssueGuarded(ctx, db.CloseIssueParams{IssueID: issue.ID, Reason: "done", Actor: "worker", ClaimGuard: &db.ClaimGuard{Required: true, ExpectedClaimUID: second.Claim.ClaimUID, Principal: principal}})
+			require.NoError(t, err)
+			assert.True(t, changed)
+			assert.Equal(t, []string{"issue.closed", "claim.released"}, eventTypeNames(events))
+		})
+	}
+	return nil
+}
