+// guardedCloseClaimTx reads authority and the unreleased tenure only after
+// close has acquired the SQLite writer lock. No lease cleanup happens on a
+// failed guard, and the returned clock governs both validation and release.
+func guardedCloseClaimTx(ctx context.Context, tx claimStore, issue db.Issue, guard *db.ClaimGuard) (*db.IssueClaim, time.Time, error) {
+	var role, hubUID string
+	var enabled int
+	err := tx.QueryRowContext(ctx, `SELECT role, enabled, hub_project_uid FROM federation_bindings WHERE project_id=?`, issue.ProjectID).Scan(&role, &enabled, &hubUID)
+	authoritative := errors.Is(err, sql.ErrNoRows) || (err == nil && role == string(db.FederationRoleHub) && enabled == 1 && katauid.Valid(hubUID))
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return nil, time.Time{}, fmt.Errorf("check close claim authority: %w", err)
+	}
+	if !authoritative {
+		return nil, time.Time{}, db.ErrPendingClaimNotAuthoritative
+	}
+	live, err := liveClaimForIssueTx(ctx, tx, issue.UID)
+	if err != nil && !errors.Is(err, db.ErrNotFound) {
+		return nil, time.Time{}, err
+	}
+	var claim *db.IssueClaim
+	if err == nil {
+		claim = &live
+	}
+	now := time.Now().UTC()
+	return claim, now, db.ValidateClaimGuard(guard, claim, authoritative, now)
+}
