@@ -0,0 +1,58 @@
+package kata_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strconv"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata"
+)
+
+func TestServiceCloseV2UsesAcquireSubjectIdentity(t *testing.T) {
+	controller := &recordingAccessController{}
+	service, err := kata.New(context.Background(), kata.Config{DSN: filepath.Join(t.TempDir(), "service.db"), Access: controller})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, service.Close()) })
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		subject := r.Header.Get("X-Test-Subject")
+		if subject == "" {
+			subject = "pi:session:execution-one"
+		}
+		service.Handler().ServeHTTP(w, r.WithContext(kata.WithPrincipal(r.Context(), kata.Principal{Subject: subject, Actor: "Agent"})))
+	}))
+	t.Cleanup(server.Close)
+	project := createProject(t, server.URL, "example-project")
+	issue := createAccessIssue(t, server, project.Project.ID, "strict close")
+	path := server.URL + "/api/v1/projects/" + strconv.FormatInt(project.Project.ID, 10) + "/issues/" + issue.Issue.ShortID
+	var acquired struct {
+		Lease struct {
+			ClaimUID string `json:"claim_uid"`
+		} `json:"lease"`
+	}
+	postJSON(t, server.Client(), path+"/lease/actions/acquire", `{"holder":"ignored","client_kind":"ignored","claim_kind":"hard"}`, &acquired)
+	require.NotEmpty(t, acquired.Lease.ClaimUID)
+	for _, subject := range []string{"pi:session:execution-two", "pi:session:execution-one"} {
+		req, err := http.NewRequest(http.MethodPost, path+"/actions/close", bytes.NewBufferString(`{"actor":"ignored","client_kind":"different-ignored-value","reason":"wontfix","message":"Reviewed the request and recorded why the work should stop here.","retry_protocol":"close-v2"}`))
+		require.NoError(t, err)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-Test-Subject", subject)
+		req.Header.Set("If-Lease-Match", acquired.Lease.ClaimUID)
+		resp, err := server.Client().Do(req)
+		require.NoError(t, err)
+		var body map[string]any
+		require.NoError(t, json.NewDecoder(resp.Body).Decode(&body))
+		require.NoError(t, resp.Body.Close())
+		if subject == "pi:session:execution-two" {
+			assert.Equal(t, http.StatusConflict, resp.StatusCode, body)
+		} else {
+			assert.Equal(t, http.StatusOK, resp.StatusCode, body)
+		}
+	}
+}
