+// guardedCloseClaimTx runs after the issue lock and revision precondition. The
+// claim row lock fences expiry/cache writers as well as tenure replacement.
+// Each serializable retry obtains a fresh decision timestamp after these locks.
+func guardedCloseClaimTx(ctx context.Context, tx *sql.Tx, issue db.Issue, guard *db.ClaimGuard) (*db.IssueClaim, time.Time, error) {
+	var role, hubUID string
+	var enabled int
+	err := tx.QueryRowContext(ctx, `SELECT role, enabled, hub_project_uid FROM federation_bindings WHERE project_id=$1 FOR SHARE`, issue.ProjectID).Scan(&role, &enabled, &hubUID)
+	authoritative := errors.Is(err, sql.ErrNoRows) || (err == nil && role == string(db.FederationRoleHub) && enabled == 1 && katauid.Valid(hubUID))
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return nil, time.Time{}, mapSQLError(err, nil)
+	}
+	if !authoritative {
+		return nil, time.Time{}, db.ErrPendingClaimNotAuthoritative
+	}
+	live, err := claimForIssueTx(ctx, tx, issue.UID, true)
+	if err != nil && !errors.Is(err, db.ErrNotFound) {
+		return nil, time.Time{}, err
+	}
+	var claim *db.IssueClaim
+	if err == nil {
+		claim = &live
+	}
+	now := time.Now().UTC()
+	return claim, now, db.ValidateClaimGuard(guard, claim, authoritative, now)
+}
+
+// annotateGuardedClaimCloseTx retains the hub audit using the guard's locked
+// tenure and decision clock. The legacy annotator intentionally keeps its own
+// wall clock for unguarded callers.
+func (s *Store) annotateGuardedClaimCloseTx(ctx context.Context, tx *sql.Tx, input claimWorkMutationInput, claim db.IssueClaim, now time.Time) ([]db.Event, error) {
+	hub, err := enabledHubFederationBindingTx(ctx, tx, input.Project.ID)
+	if err != nil || !hub {
+		return nil, err
+	}
+	events, err := s.expireTimedClaimsTx(ctx, tx, input.Project.ID, now, 0)
+	if err != nil {
+		return nil, err
+	}
+	if !claimWorkCoveredByLiveClaim(claim, input.HolderInstanceUID, input.Actor) {
+		violation, err := s.insertClaimViolationEventTx(ctx, tx, input, claim)
+		if err != nil {
+			return nil, err
+		}
+		events = append(events, violation)
+	}
+	return events, nil
+}
