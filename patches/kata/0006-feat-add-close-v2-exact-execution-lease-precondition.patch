+// A test-local trigger pauses the actual close write until the validated timed
+// lease expires. The decision timestamp must govern release too, including on
+// hubs whose legacy audit independently expires leases.
+func checkClaimGuardDecisionTime(t *testing.T, store db.Storage, backend Backend) error {
+	ctx := context.Background()
+	for _, role := range []string{"standalone", "hub"} {
+		t.Run(role, func(t *testing.T) {
+			project, err := store.CreateProject(ctx, "guard-clock-"+role)
+			require.NoError(t, err)
+			if role == "hub" {
+				_, err = store.EnableProjectFederation(ctx, project.ID, "worker")
+				require.NoError(t, err)
+			}
+			issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "lease deadline", Author: "worker"})
+			require.NoError(t, err)
+			principal := db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"}
+			expiresAt := time.Now().UTC().Add(time.Second)
+			acquired, err := store.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: principal, ClaimKind: "timed", TTL: time.Minute, Now: expiresAt.Add(-time.Minute)})
+			require.NoError(t, err)
+			remove, err := backend.InstallClaimCloseDelay(ctx, store, expiresAt)
+			require.NoError(t, err)
+			defer func() { require.NoError(t, remove()) }()
+			closed, events, changed, err := store.CloseIssueGuarded(ctx, db.CloseIssueParams{IssueID: issue.ID, Reason: "done", Actor: "worker", ClaimGuard: &db.ClaimGuard{Required: true, ExpectedClaimUID: acquired.Claim.ClaimUID, Principal: principal}})
+			require.NoError(t, err)
+			assert.True(t, changed)
+			assert.Equal(t, "closed", closed.Status)
+			assert.False(t, time.Now().Before(expiresAt), "trigger must cross the lease deadline")
+			assert.Equal(t, []string{"issue.closed", "claim.released"}, eventTypeNames(events))
+			status, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			assert.False(t, status.Held)
+		})
+	}
+	return nil
+}
