+// A request admitted while the lease is live must not retain an early clock
+// across its transaction fence. The lease is stale before locks are acquired.
+func checkClaimGuardFenceClock(t *testing.T, store db.Storage) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	project, err := store.CreateProject(ctx, "guard-fence-clock")
+	require.NoError(t, err)
+	issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "fenced expiry", Author: "worker"})
+	require.NoError(t, err)
+	principal := db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"}
+	expiresAt := time.Now().UTC().Add(time.Second)
+	acquired, err := store.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: principal, ClaimKind: "timed", TTL: time.Minute, Now: expiresAt.Add(-time.Minute)})
+	require.NoError(t, err)
+	before, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+	require.NoError(t, err)
+	cursor, err := store.MaxEventID(ctx)
+	require.NoError(t, err)
+	fenced := db.WithTransactionFence(ctx, func(ctx context.Context, _ db.Transaction) error {
+		timer := time.NewTimer(time.Until(expiresAt.Add(10 * time.Millisecond)))
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	})
+	_, events, changed, err := store.CloseIssueGuarded(fenced, db.CloseIssueParams{IssueID: issue.ID, Reason: "done", Actor: "worker", ClaimGuard: &db.ClaimGuard{Required: true, ExpectedClaimUID: acquired.Claim.ClaimUID, Principal: principal}})
+	require.ErrorIs(t, err, db.ErrClaimExpired)
+	assert.False(t, changed)
+	assert.Empty(t, events)
+	assertClaimGuardUnchanged(t, store, issue, before, cursor)
+	return nil
+}
