+)
+
+func strictCloseBody() map[string]any {
+	return map[string]any{"actor": "agent-a", "client_kind": "cli", "reason": "wontfix", "message": "Reviewed the request and recorded why the work should stop here.", "retry_protocol": "close-v2"}
+}
+
+func TestCloseV2ProtocolRequired(t *testing.T) {
+	for _, protocol := range []string{"", "close-v1", "close-v2"} {
+		name := protocol
+		if name == "" {
+			name = "missing-protocol"
+		}
+		t.Run(name, func(t *testing.T) {
+			env := testenv.New(t)
+			project, issue := createStandaloneClaimIssue(t, env)
+			body := strictCloseBody()
+			body["retry_protocol"] = protocol
+			headers := map[string]string{}
+			if protocol != "close-v2" {
+				headers["If-Lease-Match"] = "01HZNQ7VFPK1XGD8R5MABCD4EF"
+			}
+			resp, raw := envDoRaw(t, env, http.MethodPost, issuePathRef(project.ID, issue.ShortID, "actions/close"), body, headers)
+			code := "protocol_required"
+			if protocol == "close-v2" {
+				code = "lease_precondition_required"
+			}
+			assertAPIError(t, resp.StatusCode, raw, http.StatusBadRequest, code)
+			unchanged, err := env.DB.IssueByID(context.Background(), issue.ID)
+			require.NoError(t, err)
+			assert.Equal(t, "open", unchanged.Status)
+		})
+	}
+}
+
+func TestCloseV2ExactLease(t *testing.T) {
+	for _, state := range []string{"missing", "expired", "wrong-uid", "wrong-holder", "wrong-client", "valid"} {
+		t.Run(state, func(t *testing.T) {
+			env := testenv.New(t)
+			project, issue := createStandaloneClaimIssue(t, env)
+			expected := "01HZNQ7VFPK1XGD8R5MABCD4EF"
+			if state != "missing" {
+				now := time.Now()
+				if state == "expired" {
+					now = now.Add(-2 * time.Minute)
+				}
+				result, err := env.DB.AcquireClaim(context.Background(), db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: db.ClaimPrincipal{HolderInstanceUID: env.DB.InstanceUID(), Holder: "agent-a", ClientKind: "cli"}, ClaimKind: "timed", TTL: time.Minute, Now: now})
+				require.NoError(t, err)
+				require.NotNil(t, result.Claim)
+				if state != "wrong-uid" {
+					expected = result.Claim.ClaimUID
+				}
+			}
+			body := strictCloseBody()
+			if state == "wrong-holder" {
+				body["actor"] = "other-agent"
+			}
+			if state == "wrong-client" {
+				body["client_kind"] = "other-client"
+			}
+			resp, raw := envDoRaw(t, env, http.MethodPost, issuePathRef(project.ID, issue.ShortID, "actions/close"), body, map[string]string{"If-Lease-Match": expected})
+			if state != "valid" {
+				code := map[string]string{"missing": "claim_required", "expired": "claim_expired", "wrong-uid": "claim_lost", "wrong-holder": "claim_denied", "wrong-client": "claim_denied"}[state]
+				assertAPIError(t, resp.StatusCode, raw, http.StatusConflict, code)
+				unchanged, err := env.DB.IssueByID(context.Background(), issue.ID)
+				require.NoError(t, err)
+				assert.Equal(t, "open", unchanged.Status)
+				return
+			}
+			require.Equal(t, http.StatusOK, resp.StatusCode, string(raw))
+			var out struct {
+				Issue   db.Issue `json:"issue"`
+				Changed bool     `json:"changed"`
+			}
+			require.NoError(t, json.Unmarshal(raw, &out))
+			assert.True(t, out.Changed)
+			assert.Equal(t, "closed", out.Issue.Status)
+			status, err := env.DB.ClaimStatusReadOnly(context.Background(), project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			assert.False(t, status.Held)
+		})
+	}
+}
