--- /dev/null
+++ b/internal/db/claim_guard.go
@@ -0,0 +1,37 @@
+package db
+
+import "time"
+
+// ClaimGuard fences close against an exact authoritative lease tenure. A nil
+// guard or Required=false preserves legacy, unconditional claim behavior.
+// Principal comparison always includes holder, instance, and client kind.
+type ClaimGuard struct {
+	Required         bool
+	ExpectedClaimUID string
+	Principal        ClaimPrincipal
+}
+
+// ValidateClaimGuard is a pure check of state already read under the close
+// transaction's locks. It never expires claims or emits events. The caller must
+// reuse now for releasing this tenure, not sample the clock after validation.
+func ValidateClaimGuard(guard *ClaimGuard, claim *IssueClaim, authoritative bool, now time.Time) error {
+	if guard == nil || !guard.Required {
+		return nil
+	}
+	if !authoritative {
+		return ErrPendingClaimNotAuthoritative
+	}
+	if claim == nil || claim.ReleasedAt != nil {
+		return ErrClaimRequired
+	}
+	if claim.ClaimKind == "timed" && claim.ExpiresAt != nil && !claim.ExpiresAt.After(now) {
+		return ErrClaimExpired
+	}
+	if claim.ClaimUID != guard.ExpectedClaimUID {
+		return ErrClaimLost
+	}
+	if !SameClaimPrincipal(*claim, guard.Principal) {
+		return ErrClaimDenied
+	}
+	return nil
+}
