@@ -0,0 +1,389 @@
+package dbtest
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/db"
+	"go.kenn.io/kata/internal/uid"
+)
+
+// Contract: close uses an authoritative, unexpired, exact tenure and holder
+// tuple in its write transaction. Rejections must not change any durable state.
+func checkClaimGuardClose(t *testing.T, store db.Storage) error {
+	ctx := context.Background()
+	for _, role := range []string{"standalone", "hub"} {
+		for _, name := range []string{"required", "expired", "wrong-uid", "holder", "instance", "client-kind", "hard", "timed", "nil", "optional"} {
+			t.Run(role+"/"+name, func(t *testing.T) {
+				project, err := store.CreateProject(ctx, "guard-"+role+"-"+name)
+				require.NoError(t, err)
+				if role == "hub" {
+					_, err = store.EnableProjectFederation(ctx, project.ID, "worker")
+					require.NoError(t, err)
+				}
+				issue, _, err := store.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "guarded work", Author: "worker"})
+				require.NoError(t, err)
+				principal := db.ClaimPrincipal{HolderInstanceUID: store.InstanceUID(), Holder: "worker", ClientKind: "agent"}
+				guard := &db.ClaimGuard{Required: true, Principal: principal}
+				var want error
+				if name == "required" || name == "nil" || name == "optional" {
+					want = db.ErrClaimRequired
+				} else {
+					now, kind, ttl := time.Now().UTC(), "hard", time.Duration(0)
+					if name == "expired" || name == "timed" {
+						kind, ttl = "timed", time.Hour
+					}
+					if name == "expired" {
+						now = now.Add(-2 * time.Hour)
+					}
+					acquired, err := store.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, Principal: principal, ClaimKind: kind, TTL: ttl, Now: now})
+					require.NoError(t, err)
+					guard.ExpectedClaimUID = acquired.Claim.ClaimUID
+				}
+				switch name {
+				case "expired":
+					want = db.ErrClaimExpired
+				case "wrong-uid":
+					guard.ExpectedClaimUID, err = uid.New()
+					require.NoError(t, err)
+					guard.Principal.Holder = "also-wrong"
+					want = db.ErrClaimLost
+				case "holder":
+					guard.Principal.Holder, want = "other", db.ErrClaimDenied
+				case "instance":
+					guard.Principal.HolderInstanceUID, err = uid.New()
+					require.NoError(t, err)
+					want = db.ErrClaimDenied
+				case "client-kind":
+					guard.Principal.ClientKind, want = "cli", db.ErrClaimDenied
+				case "nil":
+					guard, want = nil, nil
+				case "optional":
+					guard.Required, want = false, nil
+				}
+				before, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+				require.NoError(t, err)
+				cursor, err := store.MaxEventID(ctx)
+				require.NoError(t, err)
+				closed, events, changed, err := store.CloseIssueGuarded(ctx, db.CloseIssueParams{IssueID: issue.ID, Reason: "done", Actor: "worker", ClaimGuard: guard})
+				if want != nil {
+					require.ErrorIs(t, err, want)
+					assert.False(t, changed)
+					assert.Empty(t, events)
+					assertClaimGuardUnchanged(t, store, issue, before, cursor)
+					return
+				}
+				require.NoError(t, err)
+				assert.True(t, changed)
+				assert.Equal(t, "closed", closed.Status)
+				wantTypes := []string{"issue.closed"}
+				if before.Held {
+					wantTypes = append(wantTypes, "claim.released")
+				}
+				assert.Equal(t, wantTypes, eventTypeNames(events))
+				durable, err := store.EventsAfter(ctx, db.EventsAfterParams{AfterID: cursor, Limit: 100})
+				require.NoError(t, err)
+				assert.Equal(t, eventUIDs(events), eventUIDs(durable))
+				after, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+				require.NoError(t, err)
+				assert.False(t, after.Held)
+				if before.Held {
+					var payload struct {
+						ClaimUID string `json:"claim_uid"`
+						Reason   string `json:"reason"`
+					}
+					require.NoError(t, json.Unmarshal([]byte(events[len(events)-1].Payload), &payload))
+					assert.Equal(t, before.Claim.ClaimUID, payload.ClaimUID)
+					assert.Equal(t, "issue_closed", payload.Reason)
+				}
+			})
+		}
+	}
+	return nil
+}
