+++ b/internal/daemon/handlers_close_lease_retry_test.go
@@ -0,0 +1,82 @@
+package daemon_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/kata/internal/api"
+	"go.kenn.io/kata/internal/daemon"
+	"go.kenn.io/kata/internal/db"
+)
+
+func TestCloseV2ReceiptReplayAndTenureIsolation(t *testing.T) {
+	for _, failure := range []string{"response-lost", "commit-ambiguous", "receipt-read-fails"} {
+		t.Run(failure, func(t *testing.T) {
+			database := openTestDB(t)
+			ctx := context.Background()
+			project, err := database.db.CreateProject(ctx, "retry-project")
+			require.NoError(t, err)
+			issue, _, err := database.db.CreateIssue(ctx, db.CreateIssueParams{ProjectID: project.ID, Title: "strict retry", Author: "agent-a"})
+			require.NoError(t, err)
+			claim, err := database.db.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, ClaimKind: "hard", Principal: db.ClaimPrincipal{HolderInstanceUID: database.db.InstanceUID(), Holder: "agent-a", ClientKind: "cli"}})
+			require.NoError(t, err)
+			store := &lostCloseResponseStore{Storage: database.db, failNext: failure != "response-lost", failIssueReadOnce: failure == "receipt-read-fails"}
+			sink := &recordingSink{}
+			ts := startTestServer(t, daemon.ServerConfig{DB: store, StartedAt: database.now, Hooks: sink})
+			path := issueURLRef(project.ID, issue.UID, "actions/close")
+			headers := map[string]string{"Idempotency-Key": "logical-close-attempt", "If-Lease-Match": claim.Claim.ClaimUID}
+			body := strictCloseBody()
+			first := postWithHeader(t, ts, path, headers, body)
+			if failure == "receipt-read-fails" {
+				assertAPIError(t, first.status, first.body, http.StatusInternalServerError, "internal")
+			} else {
+				requireOK(t, first)
+			}
+			status, err := store.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			assert.False(t, status.Held)
+			committed := sink.snapshot()
+			require.Len(t, committed, 2)
+			assert.Equal(t, "issue.closed", committed[0].Type)
+			assert.Equal(t, "claim.released", committed[1].Type)
+
+			// The retry must restore the receipt even though its lease no longer exists.
+			retry := postWithHeader(t, ts, path, headers, body)
+			requireOK(t, retry)
+			var out api.MutationResponse
+			require.NoError(t, json.Unmarshal(retry.body, &out.Body))
+			assert.True(t, out.Body.Reused)
+			require.NotNil(t, out.Body.OriginalEvent)
+			assert.Equal(t, committed[0].UID, out.Body.OriginalEvent.UID)
+			assert.Equal(t, committed, sink.snapshot(), "never publish receipt replay twice")
+
+			// Restore an open issue/new tenure to demonstrate an old receipt cannot
+			// close new work and that changing tenure/protocol cannot reuse its key.
+			_, _, _, err = database.db.ReopenIssue(ctx, issue.ID, "supervisor")
+			require.NoError(t, err)
+			replacement, err := database.db.AcquireClaim(ctx, db.AcquireClaimParams{ProjectID: project.ID, IssueRef: issue.UID, ClaimKind: "hard", Principal: db.ClaimPrincipal{HolderInstanceUID: database.db.InstanceUID(), Holder: "agent-a", ClientKind: "cli"}})
+			require.NoError(t, err)
+			require.NotEqual(t, claim.Claim.ClaimUID, replacement.Claim.ClaimUID)
+			requireOK(t, postWithHeader(t, ts, path, headers, body))
+			headers["If-Lease-Match"] = replacement.Claim.ClaimUID
+			mismatch := postWithHeader(t, ts, path, headers, body)
+			assertAPIError(t, mismatch.status, mismatch.body, http.StatusConflict, "idempotency_mismatch")
+			delete(headers, "If-Lease-Match")
+			body["retry_protocol"] = "close-v1"
+			mismatch = postWithHeader(t, ts, path, headers, body)
+			assertAPIError(t, mismatch.status, mismatch.body, http.StatusConflict, "idempotency_mismatch")
+			current, err := database.db.IssueByID(ctx, issue.ID)
+			require.NoError(t, err)
+			assert.Equal(t, "open", current.Status)
+			status, err = database.db.ClaimStatusReadOnly(ctx, project.ID, issue.UID, time.Now())
+			require.NoError(t, err)
+			require.NotNil(t, status.Claim)
+			assert.Equal(t, replacement.Claim.ClaimUID, status.Claim.ClaimUID)
+		})
+	}
+}
