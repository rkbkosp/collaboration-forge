+// closeRequestIdempotencyFingerprint preserves the exact close-v1 hash while
+// domain-separating close-v2 receipts by protocol and execution tenure. Receipt
+// lookup stays before live-lease validation, including after ambiguous commits.
+func closeRequestIdempotencyFingerprint(issueUID, actor string, in *api.CloseActionRequest, revision *int64) string {
+	legacy := closeIdempotencyFingerprint(issueUID, in.Ref, actor, in.Body.Reason,
+		in.Body.Message, in.Body.Source, in.Body.Evidence, in.Body.DryRun, revision)
+	if in.Body.RetryProtocol != api.CloseLeaseProtocol {
+		return legacy
+	}
+	encoded, _ := json.Marshal(struct {
+		Protocol           string `json:"protocol"`
+		RequestFingerprint string `json:"request_fingerprint"`
+		ExpectedClaimUID   string `json:"expected_claim_uid"`
+		ClientKind         string `json:"client_kind"`
+	}{in.Body.RetryProtocol, legacy, in.IfLeaseMatch, in.Body.ClientKind})
+	sum := sha256.Sum256(encoded)
+	return hex.EncodeToString(sum[:])
+}
+
